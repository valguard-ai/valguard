{
  "name": "list_length blocks empty items array",
  "policy": {
    "version": 1,
    "name": "list",
    "mode": "enforce",
    "rules": [
      {
        "id": "valid_format",
        "params": {
          "format": "json"
        },
        "on_fail": "block"
      },
      {
        "id": "list_length",
        "params": {
          "field": "items",
          "min": 1,
          "max": 5
        },
        "on_fail": "block"
      }
    ]
  },
  "output": "{\"items\":[]}",
  "input_text": "",
  "expect_blocked": true,
  "expect_would_enforce": true,
  "expect_failed_rules": ["list_length"]
}
