{
  "name": "init policy accepts nested JSON after preamble + fence",
  "policy": {
    "version": 1,
    "name": "init_sample",
    "mode": "enforce",
    "rules": [
      {
        "id": "valid_format",
        "params": {
          "format": "json"
        },
        "on_fail": "block"
      },
      {
        "id": "required_fields",
        "params": {
          "fields": ["message"]
        },
        "on_fail": "block"
      }
    ]
  },
  "output": "Here:\n```json\n{\"message\":\"ok\",\"meta\":{\"a\":[1,2]}}\n```",
  "input_text": "",
  "expect_blocked": false,
  "expect_would_enforce": false,
  "expect_failed_rules": []
}