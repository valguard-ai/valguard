{
  "name": "required_fields blocks missing key",
  "policy": {
    "version": 1,
    "name": "req",
    "mode": "enforce",
    "rules": [
      {
        "id": "valid_format",
        "params": {
          "format": "json"
        },
        "on_fail": "block"
      },
      {
        "id": "required_fields",
        "params": {
          "fields": [
            "total"
          ]
        },
        "on_fail": "block"
      }
    ]
  },
  "output": "{\"currency\": \"USD\"}",
  "input_text": "",
  "expect_blocked": true,
  "expect_would_enforce": true,
  "expect_failed_rules": [
    "required_fields"
  ]
}
