{
  "name": "init policy blocks preamble fence when required field missing",
  "policy": {
    "version": 1,
    "name": "init_sample",
    "mode": "enforce",
    "rules": [
      {
        "id": "valid_format",
        "params": {
          "format": "json"
        },
        "on_fail": "block"
      },
      {
        "id": "required_fields",
        "params": {
          "fields": ["message"]
        },
        "on_fail": "block"
      }
    ]
  },
  "output": "Sure.\n```json\n{\"foo\":1}\n```",
  "input_text": "",
  "expect_blocked": true,
  "expect_would_enforce": true,
  "expect_failed_rules": ["required_fields"]
}