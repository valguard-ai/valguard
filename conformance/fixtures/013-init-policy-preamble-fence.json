        "on_fail": "block"
      },
      {
        "id": "required_fields",
        "params": {
          "fields": ["message"]
        },
        "on_fail": "block"
      }
    ]
  },
  "output": "Sure.\n```json\n{\"message\":\"ok\"}\n```\nThanks.",
  "input_text": "",
  "expect_blocked": false,
  "expect_would_enforce": false,
  "expect_failed_rules": []
}
