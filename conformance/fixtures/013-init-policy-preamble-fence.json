{
  "name": "init policy accepts preamble + JSON fence (valid_format + required_fields)",
  "policy": {
    "version": 1,
    "name": "init_sample",
    "mode": "enforce",
    "rules": [
      {
        "id": "valid_format",
        "params": {
          "format": "json"
